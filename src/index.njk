---
layout: layouts/base.njk
title: Tubonamer Music | Private Music Lessons
description: Personal piano, guitar, voice, and songwriting lessons for students of all ages.
---

<section class="home-hero" style="--hero-image: url('{{ home.heroImage }}')">
    <div class="container hero-content">
        <p class="eyebrow">{{ home.heroEyebrow }}</p>
        <h1>{{ home.heroTitle }}</h1>
        <p class="hero-lead">{{ home.heroText }}</p>
        <div class="actions">
            <a class="btn btn-primary" href="/services/">Explore lessons</a>
            <a class="btn btn-light" href="#contact">Talk with us</a>
        </div>
    </div>
</section>
<section id="about" class="section about-section">
    <div class="container about-grid">
        <div>
            <p class="eyebrow">Welcome to {{ site.name }}</p>
            <h2>{{ home.aboutTitle }}</h2>
        </div>
        <div class="about-copy">
            <p class="section-lead">{{ home.aboutText }}</p>
            <a class="text-link" href="/staff/">Meet our instructors <span aria-hidden="true">→</span></a>
        </div>
    </div>
</section>
<section class="section lessons-section">
    <div class="container">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Ways to learn</p>
                <h2>Lessons built around you</h2>
            </div>
            <a class="text-link" href="/services/">View all lessons <span aria-hidden="true">→</span></a>
        </div>
        <div class="lesson-grid">
            {% for service in services.items %}
                <article class="lesson-card">
                    <span class="lesson-number">0{{ loop.index }}</span>
                    <h3>{{ service.name }}</h3>
                    <p>{{ service.description }}</p>
                    <div class="lesson-meta"><span>{{ service.duration }}</span><strong>${{ (service.price / 100) | round(2) }}</strong></div>
                    <a href="/services/{{ service.id }}/book/">Book this lesson <span aria-hidden="true">→</span></a>
                </article>
            {% endfor %}
        </div>
    </div>
</section>
<section class="section reasons-section">
    <div class="container">
        <p class="eyebrow">Why study with us</p>
        <h2>Serious teaching, human approach</h2>
        <div class="reasons-grid">
            <article><strong>01</strong>
                <h3>Personal direction</h3>
                <p>Every lesson follows the student’s goals, pace, and taste.</p>
            </article>
            <article><strong>02</strong>
                <h3>Practical progress</h3>
                <p>Clear next steps make practice focused and rewarding.</p>
            </article>
            <article><strong>03</strong>
                <h3>Skilled mentors</h3>
                <p>Learn with experienced musicians who know how to teach.</p>
            </article>
            <article><strong>04</strong>
                <h3>Confident performance</h3>
                <p>Build the tools to play, sing, write, and share your work.</p>
            </article>
        </div>
    </div>
</section>
<section class="section instructors-section">
    <div class="container">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Your teachers</p>
                <h2>Meet the people behind the music</h2>
            </div>
            <a class="text-link" href="/staff/">Meet the full team <span aria-hidden="true">→</span></a>
        </div>
        <div class="instructor-strip">
            {% for person in staff.items %}
                <a class="instructor-tile" href="/staff/{{ person.id }}/">
                    <img src="{{ person.photo }}"
                         alt="{{ person.name }}"
                         width="480"
                         height="360" />
                    <span><strong>{{ person.name }}</strong><small>{{ person.title }}</small></span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
<section id="contact" class="section contact-section">
    <div class="container contact-grid">
        <div class="contact-intro">
            <p class="eyebrow">Start a conversation</p>
            <h2>{{ home.contactTitle }}</h2>
            <p>{{ home.contactText }}</p>
            <div class="contact-details"><a href="mailto:{{ site.email }}">{{ site.email }}</a><a href="tel:{{ site.phone | replace(' ', '') }}">{{ site.phone }}</a></div>
        </div>
        <form class="contact-form"
              name="contact"
              method="post"
              action="/contact-thanks/"
              data-netlify="true"
              netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden-field">
                <label>
                    Do not fill this out:
                    <input name="bot-field" />
                </label>
            </p>
            <div class="field-row">
                <div>
                    <label for="contact-name">Name</label>
                    <input id="contact-name" name="name" type="text" required />
                </div>
                <div>
                    <label for="contact-email">Email</label>
                    <input id="contact-email" name="email" type="email" required />
                </div>
            </div>
            <label for="contact-interest">Interested in</label>
            <select id="contact-interest" name="lesson">
                <option value="">Choose a lesson</option>
                {% for service in services.items %}
                    <option value="{{ service.id }}">{{ service.name }}</option>
                {% endfor %}
            </select>
            <label for="contact-message">Tell us about the student</label>
            <textarea id="contact-message" name="message" rows="5" required></textarea>
            <button class="btn btn-primary" type="submit">Send inquiry</button>
        </form>
    </div>
</section>
